#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HTThreeMS: HTThreeMS {
            compatible = "zmk,behavior-hold-tap";
            label = "HTTHREEMS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC           &kp N1                     &kp N2                    &kp N3                 &kp N4                 &kp N5                           &kp N6  &kp N7                  &kp N8                  &kp N9                    &kp N0                         &kp BACKSPACE
&kp TAB           &kp Q                      &kp W                     &kp E                  &kp R                  &kp T                            &kp Y   &kp U                   &kp I                   &kp O                     &kp P                          &kp MINUS
&kp LEFT_SHIFT    &HTThreeMS LEFT_CONTROL A  &HTThreeMS RIGHT_SHIFT S  &HTThreeMS LEFT_ALT D  &HTThreeMS LEFT_GUI F  &kp G                            &kp H   &HTThreeMS RIGHT_GUI J  &HTThreeMS RIGHT_ALT K  &HTThreeMS RIGHT_SHIFT L  &HTThreeMS RIGHT_CONTROL SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z                      &kp X                     &kp C                  &kp V                  &kp B   &kp LBKT      &kp RBKT   &kp N   &kp M                   &kp COMMA               &kp DOT                   &kp FSLH                       &kp RIGHT_CONTROL
                                                                       &kp LALT               &kp LGUI               &to 0   &kp RETURN    &kp SPACE  &to 1   &kp RIGHT_GUI           &kp RIGHT_ALT
            >;
        };

        Numpad {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "NumPad";
            bindings = <
&none         &none      &none     &none         &none       &none                              &none  &none            &none            &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp BACKSPACE
&none         &kp LS(P)  &none     &none         &kp LS(N)   &none                              &none  &none            &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SUBTRACT
&kp LC(LEFT)  &kp LEFT   &kp DOWN  &kp UP_ARROW  &kp RIGHT   &kp LC(RIGHT)                      &none  &none            &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS
&none         &kp COMMA  &none     &none         &kp PERIOD  &none          &none    &none      &none  &none            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_EQUAL
                                   &none         &none       &to 0          &none    &kp SPACE  &to 2  &kp KP_NUMBER_0  &kp KP_DOT
            >;
        };

        Three {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "3";
            bindings = <
&none      &none   &none   &none    &none    &none                        &none        &none      &none      &none     &none      &none
&kp GRAVE  &kp N1  &kp N2  &kp N3   &kp N4   &kp N5                       &kp N6       &kp N7     &kp N8     &kp N9    &kp N0     &none
&kp F1     &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                       &none        &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &none
&kp F7     &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &none    &none      &kp KP_PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp BSLH
                           &none    &none    &to 0    &none    &kp SPACE  &to 0        &none      &none
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
